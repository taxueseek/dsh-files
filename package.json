{
  "name": "dsh-files",
  "version": "0.5.6",
  "description": "DeepSeek Harness plugin: read_document (text/PDF/DOCX/XLSX/.doc the built-in read rejects as binary), attachment_list/export_attachment model tools, and a zero-token attachment dock (pill + library card, + menu folder upload, download/export/@ source) closing the host attachment library visibility gap.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "pdf",
    "docx",
    "xlsx"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/dsh-files.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.2.0-rc.1",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      }
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.3",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.38",
    "read-excel-file": "^5.8.7",
    "word-extractor": "^1.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "test": "npm run typecheck && node --test",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
